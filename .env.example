# Database
DATABASE_URL=sqlite:///./cerina_foundry.db

# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection
LLM_WRITER_PROVIDER=groq
LLM_WRITER_MODEL=openai/gpt-oss-120b
LLM_WRITER_FALLBACK_PROVIDER=gemini
LLM_WRITER_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_JUDGE_PROVIDER=gemini
LLM_JUDGE_MODEL=gemini-3.1-flash-lite
LLM_JUDGE_FALLBACK_PROVIDER=groq
LLM_JUDGE_FALLBACK_MODEL=qwen/qwen3.8-27b
