# Copy this file to `.env` or `backend/.env` to run locally:
#   cp .env.example .env
# Required: LLM Provider API Keys
# Free-tier keys from two different model families to satisfy the
# "Zero Same-Family Self-Grading Rule" (Drafter cannot grade its own family):
# - Groq (Free: https://console.groq.com) -> powers Drafter
# - Google AI Studio (Free: https://aistudio.google.com) -> powers Clinical Critic
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# Optional: Fallback Provider
# Used if Groq or Google hits daily quota limits
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# Optional: Local Server & Database Defaults
# (Defaults are used automatically if left commented out)
# ------------------------------------------------------------------------------
# PORT=8000
# DATABASE_URL=sqlite:///./cerina_foundry.db
